# GOSS environment configuration
#
# WHERE EACH VALUE IS ACTUALLY USED — this is a build-less static site, so
# the browser CANNOT read this file. It exists for:
#   1. Documentation/reference for the two values you must also paste into
#      assets/js/supabase-config.js by hand (SUPABASE_URL, SUPABASE_ANON_KEY)
#      so the frontend can reach your project.
#   2. Any one-off Node script you write yourself to bootstrap accounts
#      (see supabase/bootstrap.sql, Method B) — SUPABASE_SERVICE_ROLE_KEY.
#      No such script is shipped in this codebase.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY in assets/js/supabase-config.js or any
# other file the browser loads — it bypasses Row Level Security entirely.
# This .env file itself must never be committed or deployed to a static host.

# Project Settings → API → "Project URL"
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings → API → "anon public" key — safe to expose in the
# browser (also goes in assets/js/supabase-config.js). Access control is
# enforced by Postgres RLS, not by keeping this secret.
SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings → API → "service_role" key — SECRET. Only for a local
# script you write and delete yourself. Bypasses RLS completely.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
